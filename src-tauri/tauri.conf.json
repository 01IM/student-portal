{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Student Portal",
  "version": "0.1.0",
  "identifier": "com.akiconsultant.studentportal",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Student Portal · AKI Consultant",
        "width": 1440,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "AKI Consultant",
    "shortDescription": "Student Portal",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
